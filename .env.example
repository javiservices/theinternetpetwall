# ==============================================================================
# THE INTERNET PET WALL - CONFIGURACIÓN DE SEGURIDAD Y PAGOS (.env.local)
# ==============================================================================
# Copia este archivo como .env.local y rellena las claves.
# NO compartas ni subas tu archivo .env.local a GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de datos PostgreSQL + Storage de Fotos + Seguridad RLS)
# Regístrate gratis en: https://supabase.com
# ------------------------------------------------------------------------------
# Ve a: Project Settings -> API
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clave privada para el servidor (NUNCA en frontend). Project Settings -> API -> service_role:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Modo de almacenamiento ('cloud' para base de datos Supabase, 'local' para demo)
VITE_STORAGE_MODE=cloud

# ------------------------------------------------------------------------------
# 2. STRIPE (Pasarela de pagos con tarjetas, Apple Pay, Google Pay y Bizum)
# Regístrate gratis en: https://stripe.com
# ------------------------------------------------------------------------------
# En el Dashboard de Stripe (Activa "Modo de prueba" / Test Mode arriba a la derecha)
# Ve a: Desarrolladores -> Claves de API (API Keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_SECRET_KEY=sk_test_51...

# Clave secreta del Webhook de Stripe (para verificar firmas criptográficas)
# En local con Stripe CLI: stripe listen --forward-to localhost:4000/api/stripe-webhook
# O en el Dashboard: Desarrolladores -> Webhooks -> Añadir endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 3. CONFIGURACIÓN DEL SERVIDOR
# ------------------------------------------------------------------------------
PORT=4000
CLIENT_URL=http://localhost:5173
